BT 1 0 0 1 4 190.9 Tm /F3 7.1 Tf 9 TL (def separate_if\(units, ration_card, elderly\):) Tj T* (    results = []) Tj T* (    if units <= 100:) Tj T* (        results.append\("Full subsidy"\)) Tj T* (    if 101 <= units <= 200 and ration_card:) Tj T* (        results.append\("Partial subsidy"\)) Tj T* (    if units > 200 and elderly:) Tj T* (        results.append\("Subsidy for elderly member"\)) Tj T* (    if 101 <= units <= 200 and not ration_card:) Tj T* (        results.append\("No subsidy"\)) Tj T* (    if units > 200 and not elderly:) Tj T* (        results.append\("No subsidy"\)) Tj T* (    return results) Tj T*  T* (def chained_if\(units, ration_card, elderly\):) Tj T* (    if units <= 100:) Tj T* (        return "Full subsidy") Tj T* (    elif 101 <= units <= 200:) Tj T* (        if ration_card:) Tj T* (            return "Partial subsidy") Tj T* (        else:) Tj T* (            return "No subsidy") Tj T* ET
